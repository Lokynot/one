pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Code checkout completed'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('jenkins-pipeline') {
                    sh 'python3 -m pip install --user -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                dir('jenkins-pipeline') {
                    sh 'python3 -m pytest -v'
                }
            }
        }

        stage('Build') {
            steps {
                echo 'Build completed successfully!'
            }
        }
    }
}
